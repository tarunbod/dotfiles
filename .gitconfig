[user]
	email = tarunbod@gmail.com
	name = Tarun Boddupalli
[push]
	default = simple
	autoSetupRemote = true
[credentials]
	username = tarunbod
[commit]
	gpgsign = false
[github]
	user = tarunbod
[alias]
	pushu = push -u origin HEAD
[diff]
  external = difft
[filter "lfs"]
	process = git-lfs filter-process
	required = true
	clean = git-lfs clean -- %f
	smudge = git-lfs smudge -- %f
[merge]
    conflictstyle = diff3
[diff]
    colorMoved = default
